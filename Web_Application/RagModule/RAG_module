# OrchestratorModule.py

from Models import UserQuery, UserQueryHandled
from SessionManagerModule import SessionManager
import requests

class Orchestrator:

    LLM_ENDPOINT = ""  # Fill this later with your LLM endpoint

    @staticmethod
    def handle_non_relevant_query(user_query: UserQuery):
        """
        Handles irrelevant queries.
        Returns a hardcoded polite message without invoking LLM.
        """
        return {
            "response": "Sorry, I can only assist with Sabancı University-related topics. Please ask a school-related question!"
        }

    @staticmethod
    def HandleNonActionIntend(intent: str, user_query: UserQuery):
        """
        Handles non-action user messages like greetings or follow-ups.
        Prepares a minimal payload and sends to LLM endpoint.
        """
        session = SessionManager.get_session(user_query.session_id)
        past_queries = [q['query_text'] for q in session.query_list] if session else []

        payload = {
            "type": intent,  # greeting or follow-up
            "query": user_query.query_text,
            "past_interactions": [(q, None) for q in past_queries[-2:]]  # Only use last 2 for context
        }

        try:
            response = requests.post(Orchestrator.LLM_ENDPOINT, json=payload)
            if response.status_code == 200:
                return response.json()
            else:
                return {"response": "Sorry, an error occurred while processing your request."}
        except Exception as e:
            print(f"Error during LLM call: {e}")
            return {"response": "Sorry, an internal error occurred."}

    @staticmethod
    def HandleAction(handled_query: UserQueryHandled):
        """
        Handles action-based queries (document or announcement).
        Prepares a minimal payload and sends to LLM endpoint.
        """
        session = SessionManager.get_session(handled_query.user_id)
        past_queries = [q['query_text'] for q in session.query_list] if session else []

        payload = {
            "type": handled_query.intent,  # announcement or document
            "query": handled_query.text,
            "retrieved_document": handled_query.retrieved_data.content if handled_query.retrieved_data else None,
            "past_interactions": [(q, None) for q in past_queries[-2:]],
            "time_status": None,  # You can add time info here later if needed
            "data_status": Orchestrator.map_similarity_to_data_status(handled_query.similarity_score)
        }

        try:
            response = requests.post(Orchestrator.LLM_ENDPOINT, json=payload)
            if response.status_code == 200:
                return response.json()
            else:
                return {"response": "Sorry, an error occurred while processing your request."}
        except Exception as e:
            print(f"Error during LLM call: {e}")
            return {"response": "Sorry, an internal error occurred."}

    @staticmethod
    def map_similarity_to_data_status(score: float) -> str:
        """
        Maps similarity score to data_status used in prompt generation.
        """
        if score is None:
            return "null"
        if score >= 0.6:
            return "confident"
        elif score >= 0.3:
            return "mediocre"
        else:
            return "flawed"
