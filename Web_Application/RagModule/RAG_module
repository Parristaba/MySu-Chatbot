    DOCUMENT_SEARCH_ENDPOINT = ""  # Fill with actual endpoint
    """

    @staticmethod
    def handle_parsed_query(Handled_UserQuery: UserQueryHandled):
        """
        Handles the parsed user query:
        - Performs similarity search using pruned query string.
        - Routes based on intent (announcement/document).
        - Updates Handled_UserQuery with retrieved info and forwards to orchestrator.
        """

        query_pruned = Handled_UserQuery.query_pruned

        if Handled_UserQuery.intent == "announcement":
            data_id, similarity_score = searchSimilarContent(query=query_pruned, is_document=False)

            # Optional legacy API call (disabled)
            # try:
            #     response = requests.post(RAGBlock.ANNOUNCEMENT_SEARCH_ENDPOINT, json={"query_text": query_pruned})
            #     # TODO: Parse response as before if endpoint re-enabled
            # except:
            #     pass

        elif Handled_UserQuery.intent == "document":
            data_id, similarity_score = searchSimilarContent(query=query_pruned, is_document=True)

            # Optional legacy API call (disabled)
            # try:
            #     response = requests.post(RAGBlock.DOCUMENT_SEARCH_ENDPOINT, json={"query_text": query_pruned})
            #     # TODO: Parse response as before if endpoint re-enabled
            # except:
            #     pass

        else:
            # Unknown intent fallback
            # TODO: Handle this case appropriately
            # For now, we can just return a default response or raise an error
            return 

        Handled_UserQuery.retrieved_data_id = data_id
        Handled_UserQuery.similarity_score = similarity_score
        Handled_UserQuery.data_status = RAGBlock.map_similarity_to_data_status(similarity_score)

        return HandleAction(Handled_UserQuery)

    @staticmethod
    def map_similarity_to_data_status(score: float) -> str:
        """
        Maps similarity score to data_status used in prompt generation.
        """
        if score is None:
            return "null"
        elif score >= 0.6:
            return "confident"
        elif score >= 0.3:
            return "mediocre"
        else:
            return "flawed"
